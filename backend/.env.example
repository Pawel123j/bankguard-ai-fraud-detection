# Skopiuj do backend/.env i uzupełnij. Ten plik NIE zawiera sekretów.

# WYMAGANE — bez tego API odmówi startu (patrz app/security.py).
# Wygeneruj własny:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
BANKGUARD_JWT_SECRET=

# Opcjonalne — czas życia tokenu analityka (minuty, domyślnie 30).
BANKGUARD_TOKEN_TTL_MINUTES=30

# Opcjonalne — baza. Domyślnie SQLite w backend/bankguard.db.
# BANKGUARD_DATABASE_URL=sqlite:///./bankguard.db

# Opcjonalne — konto zakładane przez `python seed.py`.
# Bez BANKGUARD_DEMO_PASSWORD seed wygeneruje losowe hasło i wypisze je RAZ.
# BANKGUARD_DEMO_EMAIL=analyst@bankguard.ai
# BANKGUARD_DEMO_PASSWORD=
# BANKGUARD_DEMO_NAME=Fraud Analyst

# Opcjonalne — dozwolone źródła CORS, rozdzielone przecinkami.
# Domyślnie porty deweloperskie Vite: http://localhost:5173,http://127.0.0.1:5173
# Ustaw, gdy frontend działa pod innym adresem (np. podgląd builda albo wdrożenie).
# BANKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
